.tag.ok { background: #f0f9eb; color: #67c23a; }
.tag.warn { background: #fdf6ec; color: #e6a23c; }
.tag.danger { background: #fef0f0; color: #f56c6c; }
.tag.info { background: #f4f4f5; color: #909399; }
.card-act { padding: 12rpx 16rpx; border-top: 1rpx solid #f5f5f5; display: flex; justify-content: flex-end; gap: 24rpx; }
.link { font-size: 24rpx; color: #409eff; }
.link.danger { color: #f56c6c; }
.empty { text-align: center; color: #999; font-size: 26rpx; padding: 60rpx 0; }
.empty-tip { color: #999; font-size: 24rpx; display: block; margin: 8rpx 0; }
.sug { font-size: 26rpx; line-height: 1.8; display: block; color: #606266; }

/* 上传 */
.upload-area { border: 2rpx dashed #c0c4cc; border-radius: 16rpx; padding: 60rpx; text-align: center; background: #fafafa; }
.up-icon { font-size: 80rpx; color: #409eff; display: block; }
.up-tip { font-size: 28rpx; color: #606266; display: block; margin-top: 16rpx; }
