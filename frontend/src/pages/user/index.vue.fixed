.form-input { flex: 1; font-size: 26rpx; padding: 8rpx 12rpx; background: #f8f8f8; border-radius: 8rpx; }
.form-picker { flex: 1; font-size: 26rpx; padding: 8rpx 12rpx; background: #f8f8f8; border-radius: 8rpx; }
.form-foot, .dialog-foot { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 24rpx; }

/* 分析（高级版）*/
.analysis-wrap { padding: 4rpx 0; }
.score-card { display: flex; align-items: center; gap: 28rpx; padding: 28rpx; border-radius: 20rpx;
  background: linear-gradient(135deg, #f7f9ff 0%, #eef3ff 100%); margin-bottom: 24rpx; }
.score-ring { width: 160rpx; height: 160rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  box-shadow: 0 6rpx 18rpx rgba(91,141,239,.25); }
.score-hole { width: 122rpx; height: 122rpx; border-radius: 50%; background: #fff; display: flex; flex-direction: column;
  align-items: center; justify-content: center; }
.score-num { font-size: 52rpx; font-weight: 800; color: #303133; line-height: 1; }
.score-unit { font-size: 22rpx; color: #909399; margin-top: 2rpx; }
.score-info { flex: 1; min-width: 0; }
.score-title { font-size: 30rpx; font-weight: 700; color: #303133; display: block; }
.score-sub { font-size: 22rpx; color: #909399; display: block; margin: 4rpx 0 16rpx; }
.score-metrics { display: flex; gap: 12rpx; }
.sm { flex: 1; background: #fff; border-radius: 14rpx; padding: 14rpx 0; text-align: center; }
.sm-num { font-size: 34rpx; font-weight: 700; color: #303133; display: block; }
.sm-num.warn { color: #f6a609; }
.sm-num.danger { color: #ef6f6c; }
