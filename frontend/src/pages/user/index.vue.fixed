  justify-content: space-between;
  background: linear-gradient(135deg, #5b9cf0, #74c0fc);
  border-radius: 20rpx;
  padding: 32rpx 36rpx;
  color: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(91, 156, 240, .25);
}
.wx-weather { display: flex; flex-direction: column; }
.wx-temp { font-size: 72rpx; font-weight: 700; line-height: 1; }
