.big-btn { background: #409eff; color: #fff; font-size: 32rpx; text-align: center; padding: 36rpx; border-radius: 16rpx; }
.big-btn.loading { opacity: .7; }

/* 卡片 */
.card-box { background: #fff; border: 1rpx solid #ebeef5; border-radius: 16rpx; padding: 24rpx; margin-top: 20rpx; }
