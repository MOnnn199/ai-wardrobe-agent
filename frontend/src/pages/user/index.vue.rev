.wh-mw-picker { margin: 16rpx 0; height: 76rpx; line-height: 76rpx; background: #fff; border: 1rpx solid #dcdfe6; border-radius: 12rpx; padding: 0 20rpx; }
.wh-mw-pick-val { font-size: 28rpx; color: #303133; }
.wh-mw-actions { display: flex; gap: 16rpx; }
.wh-mw-btn { flex: 1; height: 76rpx; line-height: 76rpx; text-align: center; border-radius: 12rpx; font-size: 28rpx; }
.wh-mw-btn.cancel { background: #f5f7fa; color: #606266; }
.wh-mw-btn.save { background: #303133; color: #fff; }

/* 绌虹姸鎬?*/
.wh-empty { width: 100%; display: flex; flex-direction: column; align-items: center; padding: 80rpx 0 40rpx; gap: 16rpx; }
.wh-empty-ico { font-size: 72rpx; }
.wh-empty-text { font-size: 27rpx; color: #909399; }
.grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.card { width: calc(50% - 8rpx); background: #fff; border-radius: 12rpx; overflow: hidden; border: 1rpx solid #eee; }
.card-img { height: 240rpx; background: #f5f5f5; display: flex; align-items: center; justify-content: center; }
.full-img { width: 100%; height: 100%; }
.ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 60rpx; color: #fff; }
.card-info { padding: 14rpx 16rpx; }
.card-name { font-size: 26rpx; font-weight: 500; display: block; margin-bottom: 8rpx; }
.card-meta { font-size: 20rpx; color: #909399; margin-top: 8rpx; display: block; }
.card-meta.idle { color: #f56c6c; font-weight: 600; }
.tags { display: flex; flex-wrap: wrap; gap: 6rpx; }

/* 鑷富鎼厤 */
.panel-sub { font-size: 22rpx; color: #909399; margin-right: 12rpx; }
/* 宸ヤ綔鍙板姛鑳界綉鏍硷紙DPSTAR 椋庢牸锛氬渾瑙掓柟鍧楀浘鏍囷級 */
.wb-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28rpx 20rpx; padding: 8rpx 0; }
.wb-tile { display: flex; flex-direction: column; align-items: center; gap: 14rpx; position: relative; }
.wb-icon-wrap { width: 112rpx; height: 112rpx; border-radius: 28rpx; background: #1a1a2e; display: flex; align-items: center; justify-content: center; transition: transform .15s; }
.wb-tile:active .wb-icon-wrap { transform: scale(.92); }
.wb-ico { font-size: 52rpx; line-height: 1; }
.wb-label { font-size: 25rpx; color: #303133; font-weight: 500; white-space: nowrap; }
.wb-single { display: flex; align-items: center; gap: 24rpx; background: #fff; border: 1rpx solid #e4e7ed; border-radius: 20rpx; padding: 24rpx 28rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.04); }
.wb-single:active { opacity: .85; }
.wb-single-icon { width: 96rpx; height: 96rpx; border-radius: 24rpx; background: #1a1a2e; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.wb-single-icon .wb-ico { font-size: 48rpx; }
.wb-single-text { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.wb-single-title { font-size: 30rpx; color: #303133; font-weight: 600; }
.wb-single-sub { font-size: 24rpx; color: #909399; }
.wb-single-arrow { font-size: 40rpx; color: #c0c4cc; }
.wb-badge { position: absolute; top: 0; right: 12rpx; min-width: 32rpx; height: 32rpx; line-height: 32rpx; text-align: center; background: #f56c6c; color: #fff; font-size: 20rpx; border-radius: 16rpx; padding: 0 8rpx; }
.back-btn { font-size: 30rpx; color: #409eff; margin-right: 16rpx; }
.card.pick { position: relative; transition: all .15s; }
.card.pick.picked { border-color: #409eff; box-shadow: 0 0 0 3rpx rgba(64,158,255,.25); }
.pick-badge { position: absolute; top: 10rpx; right: 10rpx; width: 40rpx; height: 40rpx; border-radius: 50%; background: #409eff; color: #fff; font-size: 24rpx; display: flex; align-items: center; justify-content: center; }
.outfit-bar { position: sticky; bottom: 0; display: flex; align-items: center; justify-content: space-between; background: #fff; border-top: 1rpx solid #e4e7ed; padding: 16rpx 20rpx; margin: 16rpx -24rpx -24rpx; }
.ob-count { font-size: 26rpx; color: #606266; }
.ob-num { color: #409eff; font-weight: 700; font-size: 30rpx; }
.ob-status { color: #909399; font-size: 24rpx; }
.ob-clear { font-size: 26rpx; color: #f56c6c; padding: 8rpx 16rpx; }
.ob-actions { display: flex; align-items: center; gap: 12rpx; }
.ob-wear-btn { padding: 10rpx 20rpx; background: #22c1a8; color: #fff; border-radius: 8rpx; font-size: 24rpx; }
.home-outfit-actions { display: flex; justify-content: center; margin-top: 16rpx; }
.review-card { background: #fff; border: 1rpx solid #ebeef5; border-radius: 16rpx; padding: 24rpx; margin-top: 20rpx; }
.review-top { display: flex; align-items: center; gap: 28rpx; }
.score-ring { width: 140rpx; height: 140rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; position: relative; flex-shrink: 0; }
.score-num { font-size: 52rpx; font-weight: 800; color: #303133; }
.score-cap { font-size: 22rpx; color: #909399; margin-top: 16rpx; }
.review-verdict { display: flex; flex-direction: column; gap: 12rpx; }
.rv-label { font-size: 24rpx; color: #909399; }
.rv-tag { align-self: flex-start; padding: 8rpx 24rpx; border-radius: 30rpx; color: #fff; font-size: 28rpx; font-weight: 600; }
.review-img { width: 100%; margin: 20rpx 0; border-radius: 12rpx; }
.rv-block { margin-top: 18rpx; }
.rv-h { font-size: 26rpx; font-weight: 600; color: #303133; display: block; margin-bottom: 6rpx; }
.rv-c { font-size: 25rpx; color: #606266; line-height: 1.7; white-space: pre-wrap; }
.review-actions { margin-top: 20rpx; display: flex; justify-content: flex-end; }
.tag { font-size: 20rpx; padding: 4rpx 12rpx; background: #ecf5ff; color: #409eff; border-radius: 6rpx; margin-right: 6rpx; }
.tag.ok { background: #f0f9eb; color: #67c23a; }
.tag.warn { background: #fdf6ec; color: #e6a23c; }
.tag.danger { background: #fef0f0; color: #f56c6c; }
.tag.info { background: #f4f4f5; color: #909399; }
.card-act { padding: 12rpx 16rpx; border-top: 1rpx solid #f5f5f5; display: flex; justify-content: flex-end; gap: 24rpx; }
.link { font-size: 24rpx; color: #409eff; }
.link.danger { color: #f56c6c; }
.empty { text-align: center; color: #999; font-size: 26rpx; padding: 60rpx 0; }
.empty-tip { color: #999; font-size: 24rpx; display: block; margin: 8rpx 0; }
.sug { font-size: 26rpx; line-height: 1.8; display: block; color: #606266; }

/* 涓婁紶 */
.upload-area { border: 2rpx dashed #c0c4cc; border-radius: 16rpx; padding: 60rpx; text-align: center; background: #fafafa; }
.up-icon { font-size: 80rpx; color: #409eff; display: block; }
.up-tip { font-size: 28rpx; color: #606266; display: block; margin-top: 16rpx; }
.up-sub { font-size: 22rpx; color: #999; display: block; margin-top: 8rpx; }
.upload-result { margin-top: 24rpx; text-align: center; }
.result-img { max-width: 400rpx; border-radius: 12rpx; }
.detecting { text-align: center; padding: 40rpx; color: #999; font-size: 26rpx; }

/* 琛ㄥ崟 */
.form { margin-top: 20rpx; background: #fff; border-radius: 12rpx; padding: 20rpx; }
.form-row { display: flex; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.form-label { width: 120rpx; font-size: 26rpx; color: #606266; }
.form-input { flex: 1; font-size: 26rpx; padding: 8rpx 12rpx; background: #f8f8f8; border-radius: 8rpx; }
.form-picker { flex: 1; font-size: 26rpx; padding: 8rpx 12rpx; background: #f8f8f8; border-radius: 8rpx; }
.form-foot, .dialog-foot { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 24rpx; }

/* 鍒嗘瀽锛堥珮绾х増锛?*/
.analysis-wrap { padding: 4rpx 0; }
.score-card { display: flex; align-items: center; gap: 28rpx; padding: 28rpx; border-radius: 20rpx;
  background: linear-gradient(135deg, #f7f9ff 0%, #eef3ff 100%); margin-bottom: 24rpx; }
.score-ring { width: 160rpx; height: 160rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  box-shadow: 0 6rpx 18rpx rgba(91,141,239,.25); }
.score-hole { width: 122rpx; height: 122rpx; border-radius: 50%; background: #fff; display: flex; flex-direction: column;
  align-items: center; justify-content: center; }
.score-num { font-size: 52rpx; font-weight: 800; color: #303133; line-height: 1; }
.score-unit { font-size: 22rpx; color: #909399; margin-top: 2rpx; }
.score-info { flex: 1; min-width: 0; }
.score-title { font-size: 30rpx; font-weight: 700; color: #303133; display: block; }
.score-sub { font-size: 22rpx; color: #909399; display: block; margin: 4rpx 0 16rpx; }
.score-metrics { display: flex; gap: 12rpx; }
.sm { flex: 1; background: #fff; border-radius: 14rpx; padding: 14rpx 0; text-align: center; }
.sm-num { font-size: 34rpx; font-weight: 700; color: #303133; display: block; }
.sm-num.warn { color: #f6a609; }
.sm-num.danger { color: #ef6f6c; }
.sm-lab { font-size: 20rpx; color: #909399; display: block; margin-top: 2rpx; }

.block { margin-bottom: 28rpx; }
.block-title { font-size: 28rpx; font-weight: 700; color: #303133; display: block; margin-bottom: 16rpx;
  padding-left: 16rpx; border-left: 6rpx solid #5b8def; }

/* 绌挎惌鍥為【闈㈡澘 */
.wh-day-lookup { margin: 20rpx 0 8rpx; background: #fff; border-radius: 16rpx; padding: 20rpx 22rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.wh-dl-head { display: flex; align-items: center; justify-content: space-between; }
.wh-dl-title { font-size: 27rpx; color: #303133; font-weight: 600; }
.wh-dl-arrow { font-size: 25rpx; color: #909399; }
.wh-dl-body { margin-top: 18rpx; }
.wh-dl-picker { height: 76rpx; line-height: 76rpx; background: #f7f8fa; border: 1rpx solid #e4e7ed; border-radius: 12rpx; padding: 0 20rpx; margin-bottom: 16rpx; }
.wh-dl-pick-val { font-size: 28rpx; color: #303133; }
.wh-dl-items { display: flex; flex-wrap: wrap; gap: 14rpx; }
.wh-dl-chip { background: #ecf5ff; color: #409eff; font-size: 25rpx; border-radius: 10rpx; padding: 12rpx 20rpx; }
.wh-dl-empty { font-size: 25rpx; color: #909399; }

.donut-row { display: flex; align-items: center; gap: 28rpx; }
.donut { width: 200rpx; height: 200rpx; border-radius: 50%; flex-shrink: 0; position: relative;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,.08); }
.donut-hole { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
  width: 138rpx; height: 138rpx; border-radius: 50%; background: #fff; display: flex; flex-direction: column;
  align-items: center; justify-content: center; }
.donut-num { font-size: 44rpx; font-weight: 800; color: #303133; line-height: 1; }
.donut-unit { font-size: 22rpx; color: #909399; }
.legend { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 14rpx; }
.legend-item { display: flex; align-items: center; gap: 12rpx; }
.legend-dot { width: 18rpx; height: 18rpx; border-radius: 6rpx; flex-shrink: 0; }
.legend-name { font-size: 26rpx; color: #303133; flex: 1; }
.legend-val { font-size: 24rpx; color: #909399; }

.stack-bar { display: flex; height: 28rpx; border-radius: 14rpx; overflow: hidden; background: #ebeef5; }
.stack-seg { height: 100%; }
.stack-legend { display: flex; flex-wrap: wrap; gap: 20rpx; margin-top: 14rpx; }
.stack-leg { display: flex; align-items: center; gap: 8rpx; }
.stack-leg-t { font-size: 24rpx; color: #606266; }

.color-wrap { display: flex; flex-wrap: wrap; gap: 16rpx; }
.color-chip { display: flex; align-items: center; gap: 8rpx; background: #f7f8fa; border-radius: 30rpx; padding: 8rpx 18rpx; }
.color-dot { width: 26rpx; height: 26rpx; border-radius: 50%; border: 1rpx solid #e4e7ed; }
.color-name { font-size: 24rpx; color: #303133; }
.color-cnt { font-size: 22rpx; color: #909399; }

.tag-list { display: flex; flex-wrap: wrap; gap: 12rpx; }

.sug-list { display: flex; flex-direction: column; gap: 12rpx; }
.sug-item { display: flex; gap: 12rpx; background: linear-gradient(135deg,#f7f9ff,#eef3ff); border-radius: 14rpx; padding: 18rpx 20rpx; }
.sug-bullet { color: #5b8def; font-size: 24rpx; flex-shrink: 0; }
.sug-text { font-size: 25rpx; color: #454a52; line-height: 1.6; flex: 1; }
.shop { display: flex; align-items: center; gap: 16rpx; }
.shop-reason { font-size: 26rpx; color: #606266; flex: 1; }

/* 鍘嗗彶渚ц竟鎶藉眽 */
.drawer-wrap { position: fixed !important; top: 0; left: 0; right: 0; bottom: 0; z-index: 200; overflow: hidden; }
.history-drawer {
  position: absolute !important; top: 0; left: 0;
  width: 75vw; max-width: 560rpx; height: 100%;
  background: #fff;
  display: flex; flex-direction: column;
  transform: translateX(-100%);
  transition: transform .28s ease;
  box-shadow: 6rpx 0 30rpx rgba(0,0,0,.15);
  box-sizing: border-box;
}
.history-drawer.open { transform: translateX(0); }
.drawer-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.35); }
.drawer-head { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 24rpx; border-bottom: 1rpx solid #ebeef5; flex-shrink: 0; }
.drawer-title { font-size: 32rpx; font-weight: 600; color: #303133; }
.drawer-new { font-size: 26rpx; color: #409eff; padding: 8rpx 16rpx; background: #ecf5ff; border-radius: 20rpx; }
.drawer-list { flex: 1; height: 0; min-height: 0; width: 100%; padding: 16rpx 20rpx; box-sizing: border-box; }
.drawer-item { background: #f7f8fa; padding: 20rpx 22rpx; margin-bottom: 16rpx; border-radius: 12rpx; border: 1rpx solid #eef0f3; width: 100%; box-sizing: border-box; display: flex; align-items: flex-start; }
.drawer-item:active { background: #eef4ff; }
.di-main { flex: 1; min-width: 0; overflow: hidden; }
.di-del { padding: 4rpx 14rpx; margin-left: 12rpx; font-size: 34rpx; color: #c0c4cc; flex-shrink: 0; }
.di-del:active { color: #f56c6c; }
.di-q { font-weight: 500; font-size: 28rpx; color: #303133; display: block; margin-bottom: 8rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%; }
.di-turn { display: inline-block; font-size: 20rpx; color: #409eff; background: #ecf5ff; padding: 2rpx 10rpx; border-radius: 10rpx; margin-left: 10rpx; font-weight: normal; vertical-align: middle; }
.di-a { font-size: 24rpx; color: #888; display: block; margin-bottom: 10rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%; }
.di-time { font-size: 22rpx; color: #aaa; display: block; }
.drawer-empty { text-align: center; color: #999; font-size: 26rpx; padding-top: 80rpx; }

/* 涓汉涓績 */
.me-card { display: flex; align-items: center; background: #fff; border-radius: 16rpx; padding: 32rpx 28rpx; margin-bottom: 20rpx; }
.me-avatar { width: 96rpx; height: 96rpx; border-radius: 50%; background: #409eff; color: #fff; font-size: 44rpx; display: flex; align-items: center; justify-content: center; margin-right: 24rpx; flex-shrink: 0; }
.me-info { display: flex; flex-direction: column; min-width: 0; }
.me-name { font-size: 34rpx; font-weight: 600; color: #303133; }
.me-sub { font-size: 24rpx; color: #909399; margin-top: 8rpx; }
.me-list { background: #fff; border-radius: 16rpx; overflow: hidden; }
.me-row { display: flex; align-items: center; padding: 30rpx 28rpx; border-bottom: 1rpx solid #f5f5f5; }
.me-row:active { background: #f7f8fa; }
.me-row-l { flex: 1; font-size: 30rpx; color: #303133; }
.me-arrow { font-size: 40rpx; color: #c0c4cc; margin-left: 12rpx; }
.me-badge { min-width: 32rpx; height: 32rpx; padding: 0 8rpx; background: #f56c6c; color: #fff; font-size: 20rpx; line-height: 32rpx; text-align: center; border-radius: 16rpx; margin-left: auto; margin-right: 12rpx; }
.me-logout { margin-top: 40rpx; background: #fff; color: #f56c6c; text-align: center; padding: 30rpx; border-radius: 16rpx; font-size: 30rpx; border: 1rpx solid #fde2e2; }
.me-logout:active { background: #fef0f0; }

/* 搴曢儴瀵艰埅 */
.bottom-nav { height: 100rpx; background: #fff; border-top: 1rpx solid #e4e7ed; white-space: nowrap; }
.nav-item { display: inline-flex; flex-direction: column; align-items: center; justify-content: center; width: 140rpx; height: 100rpx; color: #909399; }
.nav-item.active { color: #409eff; background: #ecf5ff; }
.nav-icon { font-size: 38rpx; }
.nav-label { font-size: 20rpx; margin-top: 4rpx; }
.nav-ico-wrap { position: relative; }
.badge { position: absolute; top: -8rpx; right: -14rpx; min-width: 30rpx; height: 30rpx; padding: 0 6rpx; background: #f56c6c; color: #fff; font-size: 18rpx; line-height: 30rpx; text-align: center; border-radius: 15rpx; }

/* 鑷畾涔夐《閮ㄦ爮 */
.topbar { height: 88rpx; flex-shrink: 0; background: #1d1e1f; color: #fff; display: flex; align-items: center; justify-content: space-between; padding: 0 22rpx; box-sizing: border-box; }
.tb-title { font-size: 32rpx; font-weight: 600; }
.tb-right { display: flex; align-items: center; }

/* 鍏ㄥ眬閫氱煡閾冮摏锛堥《閮ㄦ爮鍙充晶锛岀偣鍑昏繘鍏ラ€氱煡涓績锛?*/
.notify-bell { position: relative; width: 64rpx; height: 64rpx; background: rgba(255,255,255,.16); border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.bell-ico { font-size: 34rpx; line-height: 1; }
.bell-badge { position: absolute; top: -6rpx; right: -6rpx; min-width: 30rpx; height: 30rpx; padding: 0 6rpx; background: #f56c6c; color: #fff; font-size: 18rpx; line-height: 30rpx; text-align: center; border-radius: 15rpx; }

/* 閫氱煡涓績 */
.noti { background: #fff; border: 1rpx solid #ebeef5; border-radius: 14rpx; padding: 20rpx 22rpx; margin-top: 16rpx; }
.noti.unread { border-left: 6rpx solid #409eff; }
.noti-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.noti-tag { font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 20rpx; color: #fff; background: #909399; }
.noti-tag.t-monthly_report { background: #67c23a; }
.noti-tag.t-trend_push { background: #9b59b6; }
.noti-time { font-size: 20rpx; color: #999; }
.noti-title { font-size: 28rpx; font-weight: 600; display: block; margin: 4rpx 0 8rpx; color: #303133; }
.noti-content { font-size: 25rpx; line-height: 1.7; color: #606266; white-space: pre-wrap; word-break: break-word; display: block; }
.noti-img { width: 100%; max-width: 600rpx; margin-top: 16rpx; border-radius: 12rpx; }

/* 寮圭獥 */
.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,.5); display: flex; align-items: center; justify-content: center; z-index: 99; }
.dialog { width: 640rpx; background: #fff; border-radius: 16rpx; padding: 30rpx; max-height: 84vh; overflow-y: auto; }
.dialog-title { font-size: 32rpx; font-weight: 600; display: block; margin-bottom: 20rpx; }
.dialog-img { max-height: 360rpx; border-radius: 12rpx; margin: 16rpx auto; display: block; }
.mini-btn.disabled { opacity: .5; }

/* ===== 涓婁紶寮圭獥 DPSTAR 椋庢牸 ===== */
.wh-upload-dialog { width: 660rpx; background: #fff; border-radius: 20rpx; max-height: 88vh; overflow-y: auto; display: flex; flex-direction: column; }
.wh-dlg-head { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 28rpx; border-bottom: 1rpx solid #f0f0f0; }
.wh-dlg-back { font-size: 28rpx; color: #409eff; }
.wh-dlg-title { font-size: 32rpx; font-weight: 600; color: #303133; }
.wh-dlg-up-area { margin: 24rpx 28rpx 16rpx; background: #303133; border-radius: 12rpx; padding: 28rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.wh-dlg-up-area:active { opacity: .85; }
.wh-dlg-up-ico { font-size: 34rpx; }
.wh-dlg-up-txt { font-size: 28rpx; color: #fff; font-weight: 500; }
.wh-dlg-batch { margin: 0 28rpx 20rpx; border: 2rpx dashed #dcdfe6; border-radius: 12rpx; padding: 22rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; }
.wh-dlg-batch:active { background: #f5f7fa; }
.wh-dlg-batch-ico { font-size: 30rpx; }
.wh-dlg-batch-txt { font-size: 26rpx; color: #606266; }
.wh-dlg-body { padding: 0 28rpx 28rpx; }
.wh-dlg-preview { background: #f7f8fa; border-radius: 14rpx; padding: 20rpx; display: flex; align-items: center; justify-content: center; position: relative; min-height: 280rpx; }
