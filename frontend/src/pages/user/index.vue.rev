}

// ===== 瀵硅瘽 =====
function onChatInput(e) {
  const v = e && e.detail && typeof e.detail.value === 'string' ? e.detail.value : e && typeof e.target.value === 'string' ? e.target.value : String(e || '')
  chatInput.value = v
}
function onChatConfirm() { sendChat() }
function onChatSend() { sendChat() }
function onFormInput(e, key) {
  const v = e && e.detail && typeof e.detail.value === 'string' ? e.detail.value : e && typeof e.target.value === 'string' ? e.target.value : String(e || '')
  uploadForm.value[key] = v
}

async function sendChat(text) {
  const q = (typeof text === 'string' ? text : chatInput.value).trim()
  if (!q || chatLoading.value) return
  chatInput.value = ''
  messages.value.push(markRaw({ role: 'user', content: q }))
  chatLoading.value = true
  try {
    const w = weather.value
    let url = '/user/chat?user_input=' + encodeURIComponent(q)
    if (w.city) url += '&city=' + encodeURIComponent(w.city)
    if (w.lat != null) url += '&lat=' + w.lat
    if (w.lon != null) url += '&lon=' + w.lon
    if (currentConvId.value) url += '&conversation_id=' + currentConvId.value
    const d = await get(url)
    currentConvId.value = d.conversation_id
    messages.value.push(markRaw({ role: 'agent', content: d.response, cid: d.conversation_id, rating: 0, image: d.outfit_image || '' }))
    fetchConversations()
  } catch (e) {
    messages.value.push(markRaw({ role: 'agent', content: '璇锋眰澶辫触锛岃妫€鏌ュ悗绔? }))
  }
  chatLoading.value = false
}

async function chatChooseImage() {
  try {
    const path = await chooseImage()
    const d = await upload('/user/analyze-image', path)
    messages.value.push(markRaw({ role: 'user', content: '涓婁紶浜嗕竴寮犲浘鐗囪鍒嗘瀽鎼厤', image: path }))
    chatLoading.value = true
    const q = encodeURIComponent('璇峰垎鏋愯繖寮犲浘鐗囧苟鎺ㄨ崘鎼厤鏂规銆傝瘑鍒粨鏋滐細' + (d.analysis || ''))
    let url = '/user/chat?user_input=' + q + '&city=' + encodeURIComponent(weather.value.city || '') + '&lat=' + (weather.value.lat || '') + '&lon=' + (weather.value.lon || '')
    if (currentConvId.value) url += '&conversation_id=' + currentConvId.value
    const d2 = await get(url)
    currentConvId.value = d2.conversation_id
    messages.value.push(markRaw({ role: 'agent', content: d2.response, cid: d2.conversation_id, rating: 0, image: d2.outfit_image || '' }))
    fetchConversations()
    chatLoading.value = false
  } catch (e) {
    uni.showToast({ title: '鍥剧墖鍒嗘瀽澶辫触', icon: 'none' })
  }
}

function rateByIndex(i, score) {
  const msg = messages.value[i]
  if (!msg || !msg.cid) return
  msg.rating = score
  messages.value = [...messages.value]
  try {
    post('/user/conversations/rate', { conversation_id: msg.cid, score })
    uni.showToast({ title: '璇勫垎宸叉彁浜?, icon: 'success' })
  } catch (e) {}
}

const profile = ref({ nickname: '', username: '', role: '' })
function loadProfile() {
  // 鍏堢敤鏈湴缂撳瓨蹇€熸樉绀猴紝鍐嶅紓姝ヤ粠鍚庣鎷夊彇鏈€鏂版樀绉拌鐩?
  profile.value = {
    nickname: uni.getStorageSync('nickname') || '',
    username: uni.getStorageSync('username') || '',
    role: uni.getStorageSync('role') || ''
  }
  refreshProfile()
}
async function refreshProfile() {
  try {
    const me = await get('/auth/me')
    profile.value = {
      nickname: me.nickname || profile.value.nickname,
      username: me.username || profile.value.username,
      role: me.role || profile.value.role
    }
    // 鍚屾鍥炴湰鍦帮紝淇濊瘉鍏跺畠椤甸潰/鍚庣画璇诲彇涓€鑷?
    uni.setStorageSync('nickname', profile.value.nickname)
    uni.setStorageSync('username', profile.value.username)
  } catch (e) {
    // 鎷夊彇澶辫触鍒欑淮鎸佹湰鍦扮紦瀛?
  }
}

function logout() {
  uni.removeStorageSync('token')
  uni.removeStorageSync('role')
  uni.removeStorageSync('nickname')
  uni.removeStorageSync('username')
  uni.removeStorageSync('user_id')
  uni.reLaunch({ url: '/pages/login/index' })
}

function goWardrobe() { currentView.value = 'wardrobe' }
function switchView(key) {
  currentView.value = key
  if (key === 'notify') {
    fetchNotifications()
    fetchUnread()
    // 杩涘叆閫氱煡涓績鍗宠涓哄凡璇伙細闈欓粯鏍囪鍏ㄩ儴锛堟煡鐪?宸茶锛夛紝閬垮厤閫€鍑洪噸鐧昏鏍囧娲?
    setTimeout(() => {
      if (notifications.value.some(n => !n.is_read)) {
        post('/user/notifications/read-all').then(() => {
          notifications.value.forEach(x => { x.is_read = true })
          unreadCount.value = 0
        }).catch(() => {})
      }
    }, 600)
  } else if (key === 'profile') {
    loadProfile()
  } else if (key === 'diary') {
    loadDiary()
  } else if (key === 'calendar') {
    loadCalendar()
  } else if (key === 'wardrobe') {
    loadOutfits()
  }
}
function setFilter(k) { wardrobeFilter.value = k }
function closeUpload() { showUpload.value = false }

// ===== 棣栭〉锛氬畾浣嶅ぉ姘?+ 鎸夊ぉ姘斾粠琛ｆ┍鎸戞惌閰?=====
function getLocation() {
  return new Promise((resolve, reject) => {
    uni.getLocation({ type: 'wgs84', success: r => resolve(r), fail: e => reject(e) })
  })
}
async function fetchWeather(lat, lon) {
  const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true`
  const r = await fetch(url)
  return await r.json()
}
async function reverseGeocode(lat, lon) {
  // OpenStreetMap Nominatim锛氬厤璐广€佸甫 CORS锛屾瘮宸插け鏁堢殑 bigdatacloud(bdc.io) 鍙潬
  const url = `https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lon}&accept-language=zh&zoom=10`
  const ctrl = new AbortController()
  const t = setTimeout(() => ctrl.abort(), 4000)
  try {
    const r = await fetch(url, { signal: ctrl.signal })
    if (!r.ok) return null
    const j = await r.json()
    const a = (j && j.address) || {}
    return a.city || a.town || a.county || a.state || a.province || null
  } catch (e) {
    return null
  } finally {
    clearTimeout(t)
  }
}
function weatherText(code) {
  const m = {
    0: '鏅?, 1: '鏅撮棿澶氫簯', 2: '灞€閮ㄥ浜?, 3: '闃?,
    45: '闆?, 48: '闆惧噰', 51: '姣涙瘺闆?, 53: '姣涙瘺闆?, 55: '姣涙瘺闆?,
    61: '灏忛洦', 63: '涓洦', 65: '澶ч洦', 66: '鍐婚洦', 67: '鍐婚洦',
    71: '灏忛洩', 73: '涓洩', 75: '澶ч洩', 77: '闆矑',
    80: '闃甸洦', 81: '闃甸洦', 82: '寮洪樀闆?, 85: '闃甸洩', 86: '闃甸洩',
    95: '闆烽樀闆?, 96: '闆烽樀闆ㄤ即鍐伴浌', 99: '闆烽樀闆ㄤ即鍐伴浌'
  }
  return m[code] !== undefined ? m[code] : '鏈煡'
}
async function loadWeather() {
  weatherLoading.value = true
  // 鑷姩灏濊瘯瀹氫綅锛堝甫 4s 瓒呮椂锛夛紝澶辫触/瓒呮椂/琚嫆閮藉洖閫€榛樿鍩庡競锛岀粷涓嶅崱浣?
  let lat = 39.9042, lon = 116.4074, located = false, city = '鍖椾含'
  try {
    const loc = await Promise.race([
      getLocation(),
      new Promise((_, rej) => setTimeout(() => rej(new Error('timeout')), 4000))
    ])
    lat = loc.latitude
    lon = loc.longitude
    located = true
  } catch (e) {
    // 瀹氫綅琚嫆/瓒呮椂/涓嶅彲鐢細閫€鍥為粯璁ゅ煄甯傦紙鍖椾含锛?
  }
  let wx = null, geo = null
  try { wx = await fetchWeather(lat, lon) } catch (e) { wx = null }
  // 浠呭湪鐪熸瀹氫綅鎴愬姛鏃舵墠鍙嶆煡鍩庡競鍚嶏紱瀹氫綅澶辫触/瓒呮椂鏃惰烦杩囷紝閬垮厤鏃犺皳鐨勫缃戣姹備笌鎶ラ敊
  if (located) {
    try { geo = await reverseGeocode(lat, lon) } catch (e) { geo = null }
  }
  if (geo) city = geo
  const cw = wx && wx.current_weather
  weather.value = {
    city, located,
    temperature: cw ? cw.temperature : '--',
    description: cw ? weatherText(cw.weathercode) : '澶╂皵鑾峰彇澶辫触',
    windspeed: cw ? cw.windspeed : '--',
    lat, lon
  }
  weatherLoading.value = false
  // 澶╂皵鎷垮埌鍚庯紝鐩存帴鎸夊ぉ姘斾粠琛ｆ┍鎸戜竴濂楁惌閰?
  loadHomeOutfit(false)
}
async function loadHomeOutfit(randomPick = false) {
  homeLoading.value = true
  try {
    const wx = weather.value
    const temp = (typeof wx.temperature === 'number') ? wx.temperature : null
    const w = (wx.description && wx.description !== '鏈煡' && wx.description !== '澶╂皵鑾峰彇澶辫触') ? wx.description : ''
    const city = wx.city || ''
    let url = `/user/outfit-by-weather?user_id=${getUserId()}&random_pick=${randomPick ? 'true' : 'false'}`
    if (temp !== null) url += `&temp=${temp}`
    if (w) url += `&weather=${encodeURIComponent(w)}`
    if (city) url += `&city=${encodeURIComponent(city)}`
    const d = await get(url)
    homeOutfit.value = d
  } catch (e) {
    homeOutfit.value = { text: '鎼厤鑾峰彇澶辫触锛岃绋嶅悗閲嶈瘯', image_url: '', items: [] }
  }
  homeLoading.value = false
}

async function wearTodayOutfit() {
  const items = homeOutfit.value?.items || []
  const ids = items.map(it => it.id).filter(Boolean)
  if (!ids.length) {
    uni.showToast({ title: '娌℃湁鍙爣璁扮殑琛ｇ墿', icon: 'none' })
    return
  }
  try {
    await post('/user/wardrobe/mark-worn', { ids })
    // 鍚屾椂璁板叆閲囩撼璁板綍锛堢┛鎼棩蹇楋級
    try {
      await post('/user/outfits/adopt', { item_ids: ids, source: 'today', scene: '浠婃棩绌挎惌', reason: (homeOutfit.value.text || '').slice(0, 100) })
    } catch (e) {}
    uni.showToast({ title: '宸茶褰曚粖澶╃┛浜嗚繖濂?, icon: 'success' })
    fetchWardrobe()
    fetchAnalysis()
  } catch (e) {
    uni.showToast({ title: '璁板綍澶辫触锛岃閲嶈瘯', icon: 'none' })
  }
}

// ===== 琛ｆ┍涓婁紶 / 鎶犲浘 =====
function openUpload() { showUpload.value = true }
async function chooseWardrobeImage() {
  try {
    const path = await chooseImage()
    uploadPreview.value = path
    uploadedFile.value = path
    uploadDetecting.value = true
    const d = await upload('/user/wardrobe/upload-and-tag', path)
    uploadedItemId.value = d.item ? d.item.id : null
    if (d.duplicate_warning && d.duplicate_warning.length) {
      uni.showModal({
        title: '閲嶅璐拱鎻愰啋',
        content: '琛ｆ┍閲屽凡缁忔湁绫讳技鐨勶細' + d.duplicate_warning.join('銆?) + '銆俓n纭鏄惁闇€瑕侀噸澶嶆嫢鏈夛紵',
        showCancel: false
      })
    }
    if (d.tags) {
      uploadForm.value = {
        name: d.tags.name || '',
        category: d.tags.category || 'top',
        color: d.tags.color || '',
        style: d.tags.style || '',
        season: d.tags.season || ''
      }
      uploadTags.value = d.tags
      uni.showToast({ title: 'AI璇嗗埆瀹屾垚锛岃纭鍚庝繚瀛?, icon: 'none' })
    }
  } catch (e) {
    uploadTags.value = {}
    uploadForm.value = { name: '', category: 'top', color: '', style: '', material: '', pattern: '', season: '' }
    uni.showToast({ title: 'AI璇嗗埆澶辫触锛屽彲鎵嬪姩濉啓', icon: 'none' })
  }
  uploadDetecting.value = false
}
// 鎵归噺涓婁紶锛堜笂闄?0寮狅級锛氶€愬紶璧?AI 璇嗗浘锛岃繘鍏ユ壒閲忕紪杈戝脊绐楄鐢ㄦ埛纭
async function chooseBatchImages() {
  try {
    const res = await uni.chooseImage({ count: 10, sizeType: ['compressed'], sourceType: ['album', 'camera'] })
    const files = res.tempFilePaths
    if (!files || !files.length) return
    uni.showLoading({ title: `姝ｅ湪璇嗗埆 ${files.length} 寮?..`, mask: true })
    const list = []
    let fail = 0
    for (const f of files) {
      try {
        const d = await upload('/user/wardrobe/upload-and-tag', f)
        const it = d.item || {}
        const t = d.tags || {}
        list.push({
          id: it.id,
          image_url: it.image_url || f,
          name: t.name || '琛ｇ墿',
          category: t.category || 'top',
          color: t.color || '',
          style: t.style || '',
          season: t.season || '',
          purchase_date: new Date().toISOString().slice(0, 10)
        })
      } catch (e) { fail++ }
    }
    uni.hideLoading()
    if (list.length) {
      batchEditList.value = list
      batchEditIndex.value = 0
      showBatchEdit.value = true
    }
    if (fail) {
      uni.showToast({ title: `${fail} 寮犺瘑鍒け璐, icon: 'none' })
    }
  } catch (e) { /* 鐢ㄦ埛鍙栨秷 */ }
}
function onPurchaseDateChange(e) {
  purchaseDate.value = e.detail.value
}
async function confirmUpload() {
  if (!uploadedItemId.value) {
    uni.showToast({ title: '璇峰厛涓婁紶鍥剧墖', icon: 'none' })
    return
  }
  try {
    await put('/user/wardrobe/' + uploadedItemId.value, {
      name: uploadForm.value.name,
      category: uploadForm.value.category,
      color: uploadForm.value.color,
      style: uploadForm.value.style,
      material: uploadForm.value.material,
      pattern: uploadForm.value.pattern,
      season: uploadForm.value.season,
      purchase_date: purchaseDate.value || null
    })
    uni.showToast({ title: '宸蹭繚瀛樺埌琛ｆ┍', icon: 'success' })
  } catch (e) {
    uni.showToast({ title: '淇濆瓨澶辫触', icon: 'none' })
  }
  showUpload.value = false
  resetUpload()
  fetchWardrobe()
  fetchShoppingList()
}
function resetUpload() {
  uploadPreview.value = ''; uploadTags.value = null; uploadedFile.value = ''
  uploadedItemId.value = null; purchaseDate.value = ''
  uploadForm.value = { name: '', category: 'top', color: '', style: '', season: '' }
}

// ===== 鎵归噺缂栬緫 =====
function closeBatchEdit() {
  showBatchEdit.value = false
  batchEditList.value = []
  batchEditIndex.value = 0
}
function prevBatchItem() { if (batchEditIndex.value > 0) batchEditIndex.value-- }
function nextBatchItem() { if (batchEditIndex.value < batchEditList.value.length - 1) batchEditIndex.value++ }
function onBatchFormInput(e, key) {
  const v = e && e.detail && typeof e.detail.value === 'string' ? e.detail.value : e && typeof e.target.value === 'string' ? e.target.value : String(e || '')
  if (batchEditList.value[batchEditIndex.value]) batchEditList.value[batchEditIndex.value][key] = v
}
function onBatchCatChange(e) {
  if (batchEditList.value[batchEditIndex.value]) batchEditList.value[batchEditIndex.value].category = catKeys[e.detail.value]
}
function onBatchPurchaseDateChange(e) {
  if (batchEditList.value[batchEditIndex.value]) batchEditList.value[batchEditIndex.value].purchase_date = e.detail.value
}
async function confirmBatchEdit() {
  uni.showLoading({ title: '淇濆瓨涓?..', mask: true })
  let success = 0, fail = 0
  for (const it of batchEditList.value) {
    try {
      await put('/user/wardrobe/' + it.id, {
        name: it.name || '琛ｇ墿',
        category: it.category || 'top',
        color: it.color || '',
        style: it.style || '',
        season: it.season || '',
        purchase_date: it.purchase_date || null
      })
      success++
    } catch (e) { fail++ }
  }
  uni.hideLoading()
  closeBatchEdit()
  fetchWardrobe()
  fetchShoppingList()
  uni.showToast({ title: `鎴愬姛淇濆瓨 ${success} 浠?{fail ? `锛屽け璐?${fail} 浠禶 : ''}`, icon: success > 0 ? 'success' : 'none' })
}

// ===== 琛ｆ┍鎿嶄綔 =====
function itemMeta(item) {
  const today = new Date()
  const toDate = s => s ? new Date(s) : null
  const pd = toDate(item.purchase_date)
  const lw = toDate(item.last_worn)
  const owned = pd ? Math.floor((today - pd) / 86400000) : null
  const idle = lw ? Math.floor((today - lw) / 86400000) : null
  const parts = []
  if (owned !== null) parts.push('璐叆' + owned + '澶?)
  if (idle !== null) {
    if (idle === 0) parts.push('浠婂ぉ绌胯繃')
    else if (idle === 1) parts.push('鏄ㄥぉ绌胯繃')
    else parts.push('宸? + idle + '澶╂病绌?)
  } else if (owned !== null && owned > 90) parts.push('璐叆涔呮湭绌?)
  parts.push('绌? + (item.wear_count || 0) + '娆?)
  return parts.join(' 路 ')
}
function isIdle(item) {
  const today = new Date()
  const lw = item.last_worn ? new Date(item.last_worn) : null
  const pd = item.purchase_date ? new Date(item.purchase_date) : null
  if (lw) return Math.floor((today - lw) / 86400000) > 90
  if (pd) return Math.floor((today - pd) / 86400000) > 90
  return false
}
async function markWorn(ids, wornDate) {
  try { await post('/user/wardrobe/mark-worn', { ids, worn_date: wornDate || undefined }) } catch (e) {}
}
function pickItem(id) {
  // 琛ｆ┍鍗＄墖鐨勩€屾惌閰嶃€嶏細鍔犲叆鑷富鎼厤閫夋嫨骞剁洿鎺ヨ繘鍏ャ€岃嚜宸辨惌 + AI 瀹℃牳銆嶇晫闈?
  if (!isSelected(id)) selectedIds.value.push(id)
  reviewResult.value = null
  currentView.value = 'outfit'
}
async function deleteItem(id) {
  uni.showModal({
    title: '纭畾鍒犻櫎?',
    success: async (r) => {
      if (r.confirm) {
        try { await del('/user/wardrobe/' + id); if (showDetail.value) showDetail.value = false; fetchWardrobe(); fetchShoppingList(); uni.showToast({ title: '宸插垹闄?, icon: 'success' }) } catch (e) {}
      }
    }
  })
}
// 琛ｆ┍鍗＄墖闀挎寜鎿嶄綔鑿滃崟
function showCardMenu(item) {
  uni.showActionSheet({
    itemList: ['鍔犲叆鎼厤瀹℃牳', '缂栬緫淇℃伅', '鍒犻櫎杩欎欢琛ｆ湇'],
    success: (res) => {
      if (res.tapIndex === 0) pickItem(item.id)
      else if (res.tapIndex === 2) deleteItem(item.id)
      else if (res.tapIndex === 1) openDetail(item, true)  // 缂栬緫淇℃伅 鈫?鎵撳紑璇︽儏骞剁洿鎺ヨ繘鍏ョ紪杈?
    }
  })
}
// ===== 琛ｇ墿璇︽儏 / 缂栬緫 =====
function fmtDate(s) {
  if (!s) return ''
  return String(s).slice(0, 10)
}
function openDetail(item, edit = false) {
  detailItem.value = JSON.parse(JSON.stringify(item))
  detailEditing.value = false
  showMarkWorn.value = false
  showDetail.value = true
  markWornDate.value = todayStr()
  fetchWearHistory(item.id)
  if (edit) startEdit()
}
async function fetchWearHistory(id) {
  try {
    const r = await get('/user/wardrobe/wear-history?item_id=' + id)
    wearDates.value = (r && r.dates) || []
  } catch (e) {
    wearDates.value = []
  }
}
function openMarkWorn() {
  markWornDate.value = todayStr()
  showMarkWorn.value = true
}
async function doMarkWorn() {
  try {
    await markWorn([detailItem.value.id], markWornDate.value)
    showMarkWorn.value = false
    await fetchWearHistory(detailItem.value.id)
    await fetchWardrobe()  // 鍚屾鍒锋柊琛ｆ┍锛屼娇鍗＄墖闂茬疆澶╂暟瀹炴椂鏇存柊
    const it = wardrobe.value.find(i => i.id === detailItem.value.id)
    if (it) {
      detailItem.value.last_worn = it.last_worn
      detailItem.value.wear_count = it.wear_count
    }
    uni.showToast({ title: '宸茶褰?, icon: 'success' })
  } catch (e) {
    uni.showToast({ title: '璁板綍澶辫触', icon: 'none' })
  }
}
async function deleteWearDate(dateStr) {
  const itemId = detailItem.value?.id
  if (!itemId || !dateStr) return
  uni.showModal({
    title: '鍒犻櫎璁板綍',
    content: '纭畾鍒犻櫎 ' + dateStr + ' 鐨勭┛鐫€璁板綍鍚楋紵',
    confirmColor: '#f56c6c',
    success: async (res) => {
      if (!res.confirm) return
      try {
        await post('/user/wardrobe/wear-history/delete', { item_id: itemId, worn_date: dateStr })
        await fetchWearHistory(itemId)
        await fetchWardrobe()
        uni.showToast({ title: '宸插垹闄?, icon: 'success' })
      } catch (e) {
        uni.showToast({ title: '鍒犻櫎澶辫触', icon: 'none' })
      }
    }
  })
}
function closeDetail() {
  showDetail.value = false
  detailEditing.value = false
}
function startEdit() {
  const d = detailItem.value
  detailForm.value = {
    name: d.name || '',
    category: d.category || 'top',
    color: d.color || '',
    style: d.style || '',
    season: d.season || '',
    purchase_date: fmtDate(d.purchase_date)
  }
  detailEditing.value = true
}
function cancelEdit() { detailEditing.value = false }
function onDetailFormInput(e, key) {
  const v = e && e.detail && typeof e.detail.value === 'string' ? e.detail.value : String(e || '')
  detailForm.value[key] = v
}
function onDetailCatChange(e) { detailForm.value.category = catKeys[e.detail.value] }
function onDetailPurchaseDateChange(e) { detailForm.value.purchase_date = e.detail.value }
async function saveDetail() {
  try {
    await put('/user/wardrobe/' + detailItem.value.id, {
      name: detailForm.value.name || '琛ｇ墿',
      category: detailForm.value.category || 'top',
      color: detailForm.value.color || '',
      style: detailForm.value.style || '',
      material: detailForm.value.material || '',
      pattern: detailForm.value.pattern || '',
      season: detailForm.value.season || '',
      purchase_date: detailForm.value.purchase_date || null
    })
    const idx = wardrobe.value.findIndex(i => i.id === detailItem.value.id)
    if (idx >= 0) wardrobe.value[idx] = { ...wardrobe.value[idx], ...JSON.parse(JSON.stringify(detailForm.value)) }
    Object.assign(detailItem.value, JSON.parse(JSON.stringify(detailForm.value)))
    detailEditing.value = false
    fetchWardrobe()
    fetchShoppingList()
    uni.showToast({ title: '宸蹭繚瀛?, icon: 'success' })
  } catch (e) {
    uni.showToast({ title: '淇濆瓨澶辫触', icon: 'none' })
  }
}
// 棰滆壊鍚?鈫?hex锛堢敤浜庢棤鍥惧崱鐗囩殑鍗犱綅鑹诧級
const COLOR_HEX_MAP = {
  '鐧借壊': '#f5f5f5', '鐧借壊绯?: '#f5f5f5', '绫崇櫧': '#f5f0e1', '绫宠壊': '#f0e6d2',
  '榛戣壊': '#2b2b2b', '榛戣壊绯?: '#2b2b2b', '娣辩伆': '#6b6b6b', '鐏拌壊': '#9aa0a6', '鐏拌壊绯?: '#9aa0a6', '娴呯伆': '#d4d4d4',
  '绾㈣壊': '#ef6f6c', '绾㈣壊绯?: '#ef6f6c', '閰掔孩': '#8b2323', '鐜孩': '#e84a7d', '绮夎壊': '#f78fb3', '绮夎壊绯?: '#f78fb3',
  '钃濊壊': '#5b8def', '钃濊壊绯?: '#5b8def', '娣辫摑': '#1a3a6b', '娴呰摑': '#87ceeb', '钘忛潚': '#2c3e50',
  '缁胯壊': '#22c1a8', '缁胯壊绯?: '#22c1a8', '澧ㄧ豢': '#2d5a3d', '鍐涚豢': '#556b2f', '姗勬': '#808000',
  '榛勮壊': '#f6c244', '榛勮壊绯?: '#f6c244', '姗欒壊': '#f6a609', '姗欒壊绯?: '#f6a609',
  '妫曡壊': '#8b6914', '妫曡壊绯?: '#8b6914', '椹艰壊': '#c19a6b', '鍗″叾': '#c3b091',
  '绱壊': '#9b6dff', '绱壊绯?: '#9b6dff', '钖拌。鑽?: '#b39ddb',
  '閲戣壊': '#ffd700', '閾惰壊': '#c0c0c0', '鏉忚壊': '#ffdead'
}
function getItemColorHex(item) {
  return COLOR_HEX_MAP[item.color] || COLOR_HEX_MAP[item.color?.replace('鑹?,'')] || '#e0e0e0'
}
async function openHistoryDrawer() {
  fetchConversations()
  showHistoryDrawer.value = true
  drawerOpened.value = false
  await nextTick()
  drawerOpened.value = true
}
function closeHistoryDrawer() {
  drawerOpened.value = false
  setTimeout(() => { showHistoryDrawer.value = false }, 280)
}
function newChat() {
  messages.value = []
  currentConvId.value = null
  currentView.value = 'chat'
  closeHistoryDrawer()
}
async function deleteConversation(id) {
  uni.showModal({
    title: '鍒犻櫎瀵硅瘽',
    content: '纭畾鍒犻櫎杩欐潯瀵硅瘽璁板綍鍚楋紵',
    success: async (r) => {
      if (r.confirm) {
        try {
          await del('/user/conversations/' + id)
          conversations.value = conversations.value.filter(c => c.id !== id)
          uni.showToast({ title: '宸插垹闄?, icon: 'success' })
        } catch (e) {}
      }
    }
  })
}
function openHistoryChatById(id) {
  const conv = conversations.value.find(c => c.id === id)
  if (!conv) return
  messages.value = []
  currentConvId.value = id
  const hist = Array.isArray(conv.history) ? conv.history : []
  if (hist.length) {
    hist.forEach(h => {
      messages.value.push(markRaw({ role: h.role, content: h.content, cid: id, rating: 0, image: '' }))
    })
  } else {
    messages.value.push(markRaw({ role: 'user', content: conv.user_input }))
    messages.value.push(markRaw({ role: 'agent', content: conv.agent_response || '锛堟棤鍥炲锛?, cid: conv.id, rating: conv.score }))
  }
  currentView.value = 'chat'
  closeHistoryDrawer()
}

onMounted(() => {
  fetchWardrobe()
  fetchConversations()
  fetchAnalysis()
  fetchShoppingList()
  fetchNotifications()
  fetchUnread()
  loadProfile()
  loadWeather()
  loadScenes()
  loadDiary()
  loadCalendar()
  loadOutfits()
})
</script>

