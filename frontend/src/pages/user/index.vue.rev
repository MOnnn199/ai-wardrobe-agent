  reviewResult.value = null
}
watch(selectedIds, () => {
  if (reviewTimer) clearTimeout(reviewTimer)
  if (selectedIds.value.length >= 2) {
    reviewTimer = setTimeout(() => reviewOutfit(), 800)
  } else {
    reviewResult.value = null
  }
}, { deep: true })
const outfitScoreColor = computed(() => {
  const s = reviewResult.value && reviewResult.value.score
  if (!s) return '#909399'
  if (s >= 8) return '#67c23a'
  if (s >= 6) return '#e6a23c'
  return '#f56c6c'
})
const outfitScoreRing = computed(() => {
  const s = reviewResult.value && reviewResult.value.score
  const pct = s ? Math.max(0, Math.min(100, s * 10)) : 0
  return `conic-gradient(${outfitScoreColor.value} ${pct}%, #ebeef5 ${pct}%)`
})
async function reviewOutfit() {
  if (selectedIds.value.length < 2) {
    uni.showToast({ title: '鑷冲皯閫夋嫨 2 浠惰。鐗?, icon: 'none' })
    return
  }
  reviewLoading.value = true
  reviewResult.value = null
  try {
    const d = await post('/user/outfit-review', { ids: selectedIds.value })
    reviewResult.value = d
  } catch (e) {
    uni.showToast({ title: '瀹℃牳澶辫触锛岃閲嶈瘯', icon: 'none' })
  }
  reviewLoading.value = false
}

async function confirmWearSelected() {
  if (!selectedIds.value.length) {
    uni.showToast({ title: '璇峰厛閫夋嫨琛ｇ墿', icon: 'none' })
    return
  }
  try {
    await post('/user/wardrobe/mark-worn', { ids: selectedIds.value })
    uni.showToast({ title: '宸茶褰曚粖澶╃┛浜嗙殑琛ｇ墿', icon: 'success' })
    selectedIds.value = []
    reviewResult.value = null
    fetchWardrobe()
    fetchAnalysis()
  } catch (e) {
    uni.showToast({ title: '璁板綍澶辫触锛岃閲嶈瘯', icon: 'none' })
  }
}

