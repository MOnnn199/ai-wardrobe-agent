<template>
  <view class="page">
    <!-- 鑷畾涔夐《閮ㄦ爮锛氭爣棰?+ 鍏ㄥ眬閫氱煡閾冮摏 -->
    <view class="topbar">
      <text class="tb-title">AI 绌挎惌鍔╂墜</text>
      <view class="tb-right">
        <view class="notify-bell" @click="switchView('notify')">
          <text class="bell-ico">馃敂</text>
          <text v-if="unreadCount>0" class="bell-badge">{{ unreadCount>99?'99+':unreadCount }}</text>
        </view>
      </view>
    </view>

    <!-- 涓讳綋鍐呭 -->
    <scroll-view class="main" scroll-y>
      <!-- ===== 1. 棣栭〉 ===== -->
      <view v-show="currentView==='today'" class="panel">
        <!-- 澶╂皵鍗＄墖锛堝畾浣嶅悗鏄剧ず锛?-->
        <view class="weather-card">
          <view class="wx-weather">
            <text class="wx-temp">{{ tempDisplay }}</text>
            <text class="wx-desc">{{ weather.description }}</text>
          </view>
          <view class="wx-meta">
            <text class="wx-city">馃搷 {{ weather.city }}{{ weather.located ? '' : '锛堥粯璁わ級' }}</text>
            <text v-if="weather.windspeed !== '--'" class="wx-wind">馃挩 {{ weather.windspeed }} km/h</text>
          </view>
        </view>

        <!-- 浠婃棩绌挎惌锛氭寜澶╂皵浠庤。姗辩洿鎺ユ寫涓€濂?-->
        <view class="panel-head between">
          <text class="panel-title">浠婃棩绌挎惌</text>
          <view class="mini-btn" @click="loadHomeOutfit(true)">鎹竴濂</view>
        </view>
        <view v-if="homeLoading" class="card-box"><text class="loading-text">姝ｅ湪涓轰綘鎼厤鈥</text></view>
        <view v-else-if="homeOutfit" class="card-box">
          <text class="pre">{{ homeOutfit.text }}</text>
          <image v-if="homeOutfit.image_url" :src="homeOutfit.image_url" mode="widthFix" class="outfit-img" />
          <view v-if="homeOutfit.items && homeOutfit.items.length" class="home-outfit-actions">
            <view class="mini-btn primary" @click="wearTodayOutfit">纭浠婃棩绌挎惌</view>
          </view>
        </view>
        <view v-else class="card-box"><text class="pre">琛ｆ┍杩樻病鏈夎。鐗╋紝鍘汇€岃。姗便€嶆坊鍔犲惂锝</text></view>

        <!-- 宸ヤ綔鍙帮細鎼厤涓ょ鍏ュ彛 + 蹇嵎鍔熻兘 -->
        <view class="panel-head" style="margin-top:32rpx"><text class="panel-title">宸ヤ綔鍙</text></view>

        <!-- 宸ヤ綔鍙帮細浠呬繚鐣欐惌閰嶅鏍稿叆鍙ｏ紝鍏朵粬鍔熻兘璧板簳閮ㄥ鑸?-->
        <view class="wb-single" @click="startSelfOutfit">
          <view class="wb-single-icon"><text class="wb-ico">鉁</text></view>
          <view class="wb-single-text">
            <text class="wb-single-title">鎼厤瀹℃牳</text>
            <text class="wb-single-sub">浠庤。姗遍€夊嚑浠讹紝璁?AI 鍒ゆ柇鍚堜笉鍚堥€</text>
          </view>
          <text class="wb-single-arrow">鈥</text>
        </view>

        <!-- 鍦烘櫙蹇嵎鎺ㄨ崘锛團R-C4锛夛細閫氬嫟 / 绾︿細 / 杩愬姩鈥︿竴閿敓鎴?-->
        <view class="wb-scenes">
          <view class="wb-scenes-head">
            <text class="wb-scenes-title">鍦烘櫙蹇嵎鎺ㄨ崘</text>
            <text v-if="sceneLoading" class="wb-scenes-loading">鎼厤涓€</text>
          </view>
          <view class="scene-grid">
            <view v-for="s in sceneList" :key="s.key" class="scene-chip" @click="runScene(s.key)">
              <text class="scene-ico">{{ sceneIcons[s.key] || '鉁? }}</text>
              <text class="scene-label">{{ s.label }}</text>
            </view>
          </view>
        </view>

        <!-- 鍦烘櫙鎺ㄨ崘缁撴灉寮圭獥 -->
        <view v-if="sceneResult" class="mask" @click="sceneResult = null">
          <view class="scene-dialog" @click.stop>
            <view class="wh-dlg-head">
              <text class="wh-dlg-title">{{ sceneResult.sceneLabel }}鎺ㄨ崘</text>
              <text class="wh-dlg-back" @click="sceneResult = null">鉁</text>
            </view>
            <scroll-view scroll-y class="scene-dialog-scroll">
              <text class="pre">{{ sceneResult.recommendation }}</text>
              <image v-if="sceneResult.outfit_image" :src="sceneResult.outfit_image" mode="widthFix" class="outfit-img" />
            </scroll-view>
            <view class="scene-dialog-foot">
              <view class="wh-dlg-btn cancel" @click="sceneResult = null">鍐嶇湅鐪</view>
              <view class="wh-dlg-btn primary" @click="adoptSceneResult">閲囩撼杩欏</view>
            </view>
          </view>
        </view>
      </view>

      <!-- ===== 2. AI瀵硅瘽 ===== -->
      <view v-show="currentView==='chat'" class="panel">
        <view class="panel-head between">
          <view class="head-left">
            <text class="menu-btn" @click="openHistoryDrawer">鈽</text>
            <text class="panel-title">AI 绌挎惌瀵硅瘽</text>
          </view>
          <view class="mini-btn" @click="goWardrobe">鏌ョ湅琛ｆ┍</view>
        </view>
        <view class="chat-box">
          <view v-for="(m,i) in messages" :key="i" :class="['msg','msg-'+m.role]">
            <image v-if="m.image" :src="m.image" mode="widthFix" class="chat-img" />
            <view class="bubble">
              <text class="msg-label">{{ m.role==='user'?'浣?:'AI鎼厤甯? }}</text>
              <text class="msg-text">{{ m.content }}</text>
            </view>
            <view v-if="m.role==='agent'&&m.cid" class="rate-row">
              <text v-for="n in 5" :key="n" :class="['star',{active:n<=m.rating}]" @click="rateByIndex(i,n)">鈽</text>
            </view>
          </view>
          <view v-if="chatLoading" class="msg msg-agent">
            <view class="bubble"><text class="loading-text">AI鎼厤甯堟鍦ㄦ€濊€?..</text></view>
          </view>
        </view>
        <view class="chat-input">
          <view class="icon-btn" @click="chatChooseImage">馃摲</view>
          <input class="chat-field" :value="chatInput" placeholder="鎻忚堪浣犵殑闇€姹傦紝姣斿锛氭槑澶╁紑浼氾紝甯垜鎺ㄨ崘..."
                 @input="onChatInput" @confirm="onChatConfirm" />
          <view class="send-btn" @click="onChatSend">鍙戦€</view>
        </view>
      </view>

      <!-- ===== 3. 琛ｆ┍绠＄悊锛圖PSTAR 椋庢牸锛?==== -->
      <view v-show="currentView==='wardrobe'" class="panel wh-page">

        <!-- 椤堕儴妯箙锛氭暟瀛楄。鏌?-->
        <view class="wh-banner">
          <view class="wh-banner-bg">
            <image v-if="homeOutfit?.image_url" :src="homeOutfit.image_url" mode="aspectFill" class="wh-banner-img" />
          </view>
          <view class="wh-banner-info">
            <text class="wh-banner-title">鏁板瓧琛ｆ煖 | AI琛ｆ煖</text>
            <text class="wh-banner-stats">鍙瓨 500 浠躲€€|銆€宸插瓨 {{ wardrobe.length }} 浠躲€€|銆€{{ profile.nickname || '鐢ㄦ埛' }}</text>
          </view>
        </view>

        <!-- 褰曞叆鍏ュ彛 -->
        <view class="wh-upload-entry" @click="openUpload">
          <text class="wh-up-ico">馃摲</text>
          <text class="wh-up-text">褰曞叆鏂扮殑琛ｆ湇锛圓I鑷姩璇嗗埆鍥剧墖濉祫鏂欙級</text>
        </view>

        <!-- 鍝佺被绛涢€夋爣绛炬爮锛堝甫璁℃暟锛?-->
        <view class="wh-filter-row">
          <scroll-view class="wh-cat-tabs" scroll-x :show-scrollbar="false">
            <view v-for="c in catListWithCount" :key="c.k"
                  :class="['wh-cat-tab', { active: wardrobeFilter === c.k }]"
                  @click="setFilter(c.k)">
              <text>{{ c.l }}<text v-if="c.n" class="wh-cat-n"> {{ c.n }}</text></text>
            </view>
          </scroll-view>
        </view>

        <!-- 琛ｇ墿鍗＄墖缃戞牸 -->
        <view class="wh-grid">
          <view v-for="item in filteredWardrobe" :key="item.id" class="wh-card" @click="openDetail(item)" @longpress="showCardMenu(item)">
            <view class="wh-card-img-wrap">
              <image v-if="item.image_url" :src="item.image_url" mode="aspectFit" class="wh-card-img" />
              <view v-else class="wh-card-ph" :style="{ background: getItemColorHex(item) }">
                <text class="wh-card-ph-txt">{{ item.name[0] }}</text>
              </view>
            </view>
            <text class="wh-card-name">{{ item.name }}</text>
            <view class="wh-card-del" @click.stop="deleteItem(item.id)">馃棏</view>
          </view>
          <view v-if="filteredWardrobe.length===0" class="wh-empty">
            <text class="wh-empty-ico">馃憲</text>
            <text class="wh-empty-text">琛ｆ┍绌虹┖锛岀偣鍑讳笂鏂瑰綍鍏ヤ綘鐨勭涓€浠惰。鏈嶅惂</text>
          </view>
        </view>

        <!-- 绌挎惌鍥為【锛氭煡鐪嬫煇澶╃┛浜嗕粈涔?-->
        <view class="wh-day-lookup">
          <view class="wh-dl-head" @click="showDayLookup = !showDayLookup">
            <text class="wh-dl-title">馃搮 绌挎惌鍥為【锛堢湅鏌愬ぉ绌夸簡浠€涔堬級</text>
            <text class="wh-dl-arrow">{{ showDayLookup ? '鏀惰捣' : '灞曞紑' }}</text>
          </view>
          <view v-if="showDayLookup" class="wh-dl-body">
            <picker class="wh-dl-picker" mode="date" :value="lookupDate" @change="onLookupDateChange">
              <text class="wh-dl-pick-val">{{ lookupDate || '閫夋嫨鏃ユ湡' }}</text>
            </picker>
            <view v-if="dayItems.length" class="wh-dl-items">
              <view v-for="it in dayItems" :key="it.id" class="wh-dl-chip" @click="openDetail(it)">
                <text>{{ it.name }}</text>
              </view>
            </view>
            <text v-else-if="lookupDate" class="wh-dl-empty">杩欎竴澶╄繕娌¤褰曠┛杩囦换浣曡。鏈</text>
          </view>
        </view>

        <!-- 鎴戠殑濂楄锛團R-C2锛夛細鍒涘缓 / 鏌ョ湅 / 鍒犻櫎鑷畾涔夊瑁?-->
        <view class="wh-day-lookup" style="margin-top:20rpx">
          <view class="wh-dl-head" @click="showOutfitForm = !showOutfitForm">
            <text class="wh-dl-title">馃憲 鎴戠殑濂楄锛坽{ outfits.length }}锛</text>
            <text class="wh-dl-arrow">{{ showOutfitForm ? '鏀惰捣' : '鍒涘缓' }}</text>
          </view>
          <view v-if="showOutfitForm" class="wh-outfit-form">
            <input class="cal-input" v-model="outfitForm.name" placeholder="濂楄鍚嶇О锛屽锛氬懆涓€閫氬嫟瑁? style="margin-bottom:12rpx" />
            <scroll-view scroll-y class="wh-outfit-pick">
              <view v-for="it in wardrobe" :key="it.id"
                    :class="['wh-outfit-pick-item', { sel: outfitForm.item_ids.includes(it.id) }]"
                    @click="toggleOutfitItem(it.id)">
                <text>{{ it.name }}</text>
                <text class="wh-outfit-pick-tick">{{ outfitForm.item_ids.includes(it.id) ? '鉁? : '' }}</text>
              </view>
            </scroll-view>
            <view class="wh-outfit-actions">
              <view class="wh-dlg-btn cancel" @click="showOutfitForm = false">鍙栨秷</view>
              <view class="wh-dlg-btn save" @click="createOutfit">淇濆瓨濂楄</view>
            </view>
          </view>
          <view v-if="outfits.length" class="wh-outfit-list">
            <view v-for="o in outfits" :key="o.id" class="wh-outfit-card">
              <image v-if="o.cover_url" :src="o.cover_url" mode="aspectFill" class="wh-outfit-cover" />
              <view v-else class="wh-outfit-cover ph">{{ (o.name || '濂?)[0] }}</view>
              <view class="wh-outfit-mid">
                <text class="wh-outfit-name">{{ o.name }}</text>
                <text class="wh-outfit-count">{{ o.item_ids.length }} 浠</text>
              </view>
              <view class="wh-card-del" @click.stop="deleteOutfit(o.id)">馃棏</view>
            </view>
          </view>
        </view>
      </view>

      <!-- 琛ｇ墿璇︽儏 / 缂栬緫寮圭獥 -->
      <view v-if="showDetail" class="mask" @click="closeDetail">
        <view class="wh-detail" @click.stop>
          <view class="wh-dlg-head">
            <text class="wh-dlg-title">琛ｆ湇璇︽儏</text>
            <text class="wh-dlg-back" @click="closeDetail">鉁</text>
          </view>
          <scroll-view scroll-y class="wh-detail-scroll">
            <view class="wh-detail-img-wrap">
              <image v-if="detailItem.image_url" :src="detailItem.image_url" mode="aspectFit" class="wh-detail-img" />
              <view v-else class="wh-detail-ph" :style="{ background: getItemColorHex(detailItem) }">
                <text class="wh-detail-ph-txt">{{ (detailItem.name || '?')[0] }}</text>
              </view>
            </view>

            <view v-if="!detailEditing" class="wh-detail-fields">
              <view class="wh-df"><text class="wh-df-k">鍚嶇О</text><text class="wh-df-v">{{ detailItem.name }}</text></view>
              <view class="wh-df"><text class="wh-df-k">鍝佺被</text><text class="wh-df-v">{{ catMap[detailItem.category] || detailItem.category }}</text></view>
              <view class="wh-df"><text class="wh-df-k">棰滆壊</text><text class="wh-df-v">{{ detailItem.color || '鈥? }}</text></view>
              <view class="wh-df"><text class="wh-df-k">椋庢牸</text><text class="wh-df-v">{{ detailItem.style || '鈥? }}</text></view>
              <view class="wh-df"><text class="wh-df-k">鏉愯川</text><text class="wh-df-v">{{ detailItem.material || '鈥? }}</text></view>
              <view class="wh-df"><text class="wh-df-k">鍥炬</text><text class="wh-df-v">{{ detailItem.pattern || '鈥? }}</text></view>
              <view class="wh-df"><text class="wh-df-k">瀛ｈ妭</text><text class="wh-df-v">{{ detailItem.season || '鈥? }}</text></view>
              <view class="wh-df"><text class="wh-df-k">璐叆鏃ユ湡</text><text class="wh-df-v">{{ fmtDate(detailItem.purchase_date) || '鈥? }}</text></view>
              <view class="wh-df"><text class="wh-df-k">绌跨潃娆℃暟</text><text class="wh-df-v">{{ wearDates.length }} 娆</text></view>
              <view class="wh-df"><text class="wh-df-k">鏈€杩戠┛鐫€</text><text class="wh-df-v">{{ wearDates.length ? fmtDate(wearDates[0]) : '浠庢湭璁板綍' }}</text></view>
              <view class="wh-df wh-df-col">
                <text class="wh-df-k">绌跨潃璁板綍</text>
                <view class="wh-wear-dates" v-if="wearDates.length">
                  <view v-for="(d,i) in wearDates" :key="i" class="wh-wear-chip">
                    <text>{{ d }}</text>
                    <text class="wh-wear-del" @click="deleteWearDate(d)">脳</text>
                  </view>
                </view>
                <text class="wh-df-v" v-else>鏆傛棤璁板綍</text>
              </view>
            </view>

            <!-- 鏍囪绌胯繃锛堝彲鍥炴函鍘嗗彶鏃ユ湡锛岀敤浜庢牎姝ｉ棽缃ぉ鏁帮級 -->
            <view v-if="!detailEditing && showMarkWorn" class="wh-mark-worn">
              <text class="wh-mw-label">璁板綍绌跨潃鏃ユ湡</text>
              <picker class="wh-mw-picker" mode="date" :value="markWornDate" @change="e => markWornDate = e.detail.value">
                <text class="wh-mw-pick-val">{{ markWornDate }}</text>
              </picker>
              <view class="wh-mw-actions">
                <view class="wh-mw-btn cancel" @click="showMarkWorn=false">鍙栨秷</view>
                <view class="wh-mw-btn save" @click="doMarkWorn">璁板綍绌胯繃</view>
              </view>
            </view>


            <view v-else class="wh-dlg-form">
              <view class="wh-dlg-row">
                <view class="wh-dlg-field">
                  <text class="wh-dlg-label">鍗曞搧鍚嶇О</text>
                  <input class="wh-dlg-input" :value="detailForm.name" placeholder="渚嬶細鐧借壊瀹芥澗鍗拌姳T鎭? @input="e => onDetailFormInput(e, 'name')" />
                </view>
                <view class="wh-dlg-field">
                  <text class="wh-dlg-label">鍝佺被</text>
                  <picker class="wh-dlg-picker" :range="catLabels" @change="onDetailCatChange">
                    <text :class="['wh-dlg-pick-val', { placeholder: !detailForm.category }]">{{ catMap[detailForm.category] || '璇烽€夋嫨' }}</text>
                  </picker>
                </view>
              </view>
              <view class="wh-dlg-row">
                <view class="wh-dlg-field">
                  <text class="wh-dlg-label">棰滆壊</text>
                  <input class="wh-dlg-input" :value="detailForm.color" placeholder="渚嬶細鐧借壊" @input="e => onDetailFormInput(e, 'color')" />
                </view>
                <view class="wh-dlg-field">
                  <text class="wh-dlg-label">椋庢牸</text>
                  <input class="wh-dlg-input" :value="detailForm.style" placeholder="渚嬶細绠€绾? @input="e => onDetailFormInput(e, 'style')" />
                </view>
              </view>
              <view class="wh-dlg-row">
                <view class="wh-dlg-field">
                  <text class="wh-dlg-label">鏉愯川</text>
                  <input class="wh-dlg-input" :value="detailForm.material" placeholder="渚嬶細妫? @input="e => onDetailFormInput(e, 'material')" />
                </view>
                <view class="wh-dlg-field">
                  <text class="wh-dlg-label">鍥炬</text>
                  <input class="wh-dlg-input" :value="detailForm.pattern" placeholder="渚嬶細鏉＄汗" @input="e => onDetailFormInput(e, 'pattern')" />
                </view>
              </view>
              <view class="wh-dlg-row">
                <view class="wh-dlg-field">
                  <text class="wh-dlg-label">瀛ｈ妭</text>
                  <input class="wh-dlg-input" :value="detailForm.season" placeholder="渚嬶細鍥涘" @input="e => onDetailFormInput(e, 'season')" />
                </view>
                <view class="wh-dlg-field">
                  <text class="wh-dlg-label">璐叆鏃ユ湡</text>
                  <picker class="wh-dlg-picker" mode="date" :value="detailForm.purchase_date" @change="onDetailPurchaseDateChange">
                    <text :class="['wh-dlg-pick-val', { placeholder: !detailForm.purchase_date }]">{{ detailForm.purchase_date || '璐叆鏃ユ湡' }}</text>
                  </picker>
                </view>
              </view>
            </view>
          </scroll-view>

          <view class="wh-dlg-foot">
            <template v-if="!detailEditing">
              <view class="wh-dlg-btn ghost" @click="openMarkWorn">馃憰 鏍囪绌胯繃</view>
              <view class="wh-dlg-btn cancel" @click="deleteItem(detailItem.id)">馃棏 鍒犻櫎</view>
              <view class="wh-dlg-btn save" @click="startEdit">鉁忥笍 缂栬緫</view>
            </template>
            <template v-else>
              <view class="wh-dlg-btn cancel" @click="cancelEdit">鍙栨秷</view>
              <view class="wh-dlg-btn save" @click="saveDetail">淇濆瓨</view>
            </template>
          </view>
        </view>
      </view>

      <!-- 浼犲浘鑳藉姏宸插悎骞惰繘銆屽璇濄€嶏細瀵硅瘽杈撳叆妗嗗乏杈圭殑 馃摲 鎸夐挳鍙彂鍥捐 AI 鍒嗘瀽鎼厤 -->

      <!-- ===== 5.5 鑷富鎼厤 + AI 瀹℃牳 ===== -->
      <view v-show="currentView==='outfit'" class="panel">
        <view class="panel-head between">
          <view class="head-left">
            <text class="back-btn" @click="switchView('today')">鈥?杩斿洖</text>
            <text class="panel-title">鎴戠殑鎼厤</text>
          </view>
          <text class="panel-sub">浠庤。姗辨寫鍑犱欢锛岃 AI 甯綘瀹℃牳</text>
        </view>

        <!-- 琛ｆ┍澶氶€夊尯 -->
        <view class="grid">
          <view v-for="item in wardrobe" :key="item.id"
                :class="['card', 'pick', { picked: isSelected(item.id) }]" @click="toggleSelect(item.id)">
            <view class="card-img">
              <image v-if="item.image_url" :src="item.image_url" mode="aspectFill" class="full-img" />
              <view v-else class="ph" :style="{background:item.color||'#eee'}"><text>{{ item.name[0] }}</text></view>
            </view>
            <view class="card-info">
              <text class="card-name">{{ item.name }}</text>
              <view class="tags">
                <text class="tag">{{ catMap[item.category] || item.category }}</text>
                <text class="tag ok">{{ item.color }}</text>
              </view>
            </view>
            <view v-if="isSelected(item.id)" class="pick-badge">鉁</view>
          </view>
          <view v-if="wardrobe.length===0" class="empty"><text>琛ｆ┍绌虹┖锛屽厛鍘绘坊鍔犺。鐗</text></view>
        </view>

        <!-- 瀹℃牳缁撴灉 -->
        <view v-if="reviewResult" class="review-card">
          <view class="review-top">
            <view class="score-ring" :style="{ background: outfitScoreRing }">
              <text class="score-num">{{ reviewResult.score != null ? reviewResult.score : '鈥? }}</text>
              <text class="score-cap">/10</text>
            </view>
            <view class="review-verdict">
              <text class="rv-label">AI 瀹℃牳缁撹</text>
              <text class="rv-tag" :style="{ background: outfitScoreColor }">{{ reviewResult.verdict || '宸茬偣璇? }}</text>
            </view>
          </view>
          <image v-if="reviewResult.image_url" :src="reviewResult.image_url" mode="widthFix" class="review-img" />
          <view class="rv-block"><text class="rv-h">馃帹 鑹插僵鍗忚皟</text><text class="rv-c">{{ reviewResult.color_comment || reviewResult.raw }}</text></view>
          <view class="rv-block"><text class="rv-h">馃尋 瀛ｈ妭鍚堥€傚害</text><text class="rv-c">{{ reviewResult.season_comment }}</text></view>
          <view class="rv-block"><text class="rv-h">馃帺 鍦哄悎寰椾綋搴</text><text class="rv-c">{{ reviewResult.occasion_comment }}</text></view>
          <view class="rv-block"><text class="rv-h">馃З 瀹屾暣搴</text><text class="rv-c">{{ reviewResult.completeness_comment }}</text></view>
          <view v-if="reviewResult.suggestions && reviewResult.suggestions.length" class="rv-block">
            <text class="rv-h">馃挕 鏀硅繘寤鸿</text>
            <text v-for="(s,i) in reviewResult.suggestions" :key="i" class="sug">{{ (i+1) }}. {{ s }}</text>
          </view>
        </view>

        <!-- 搴曢儴鐘舵€佹潯锛氭樉绀哄凡閫変欢鏁颁笌瀹℃牳鐘舵€?-->
        <view class="outfit-bar">
          <text class="ob-count">
            宸查€?<text class="ob-num">{{ selectedIds.length }}</text> 浠?
            <text v-if="reviewLoading" class="ob-status"> 路 AI 瀹℃牳涓€</text>
            <text v-else-if="selectedIds.length < 2" class="ob-status"> 路 鍐嶉€変竴浠跺嵆鍙鏍</text>
          </text>
          <view class="ob-actions">
            <text v-if="selectedIds.length > 0" class="ob-clear" @click="clearSelection">娓呯┖</text>
            <view v-if="selectedIds.length > 0" class="ob-wear-btn" @click="confirmWearSelected">纭浠婃棩绌跨潃</view>
          </view>
        </view>
      </view>

      <!-- ===== 6. 琛ｆ┍鍒嗘瀽 ===== -->
      <view v-show="currentView==='analysis'" class="panel">
        <view class="panel-head between">
          <text class="panel-title">琛ｆ┍鍒嗘瀽</text>
          <view class="mini-btn" @click="fetchAnalysis">鍒锋柊</view>
        </view>
        <view v-if="analysis" class="card-box analysis-wrap">
          <!-- 琛ｆ┍鍋ュ悍搴?-->
          <view class="score-card">
            <view class="score-ring" :style="{ background: 'conic-gradient(' + scoreColor + ' ' + wardrobeScore + '%, #eef0f3 ' + wardrobeScore + '%)' }">
              <view class="score-hole">
                <text class="score-num">{{ wardrobeScore }}</text>
                <text class="score-unit">鍒</text>
              </view>
            </view>
            <view class="score-info">
              <text class="score-title">{{ scoreText }}</text>
              <text class="score-sub">琛ｆ┍鍋ュ悍搴﹁瘎鍒</text>
              <view class="score-metrics">
                <view class="sm"><text class="sm-num">{{ analysis.total_items }}</text><text class="sm-lab">琛ｇ墿</text></view>
                <view class="sm"><text class="sm-num warn">{{ (analysis.unused_items||[]).length }}</text><text class="sm-lab">闂茬疆</text></view>
                <view class="sm"><text class="sm-num danger">{{ (analysis.duplicate_warnings||[]).length }}</text><text class="sm-lab">閲嶅</text></view>
              </view>
            </view>
          </view>

          <!-- 璐墿寤鸿锛堝悎骞惰嚜璐墿娓呭崟锛?-->
          <view class="block" v-if="shoppingList&&shoppingList.suggestions&&shoppingList.suggestions.length">
            <text class="block-title">璐墿寤鸿</text>
            <view v-for="(s,i) in shoppingList.suggestions" :key="i" class="card-box shop">
              <text :class="['tag', tagClass(s.category)]">{{ catMap[s.category]||s.category }}</text>
              <text class="shop-reason">{{ s.reason }}</text>
            </view>
          </view>
          <view class="block" v-else>
            <text class="block-title">璐墿寤鸿</text>
            <text class="empty-tip">浣犵殑琛ｆ┍鍝佺被榻愬叏锛屾殏鏃犺喘鐗╁缓璁</text>
          </view>

          <!-- 鍝佺被鍒嗗竷 -->
          <view class="block">
            <text class="block-title">鍝佺被鍒嗗竷</text>
            <view class="donut-row" v-if="categoryChart.items.length">
              <view class="donut" :style="{ background: categoryChart.gradient }">
                <view class="donut-hole">
                  <text class="donut-num">{{ categoryChart.total }}</text>
                  <text class="donut-unit">浠</text>
                </view>
              </view>
              <view class="legend">
                <view v-for="it in categoryChart.items" :key="it.raw" class="legend-item">
                  <view class="legend-dot" :style="{ background: it.color }"></view>
                  <text class="legend-name">{{ it.name }}</text>
                  <text class="legend-val">{{ it.value }} 路 {{ it.pct }}%</text>
                </view>
              </view>
            </view>
            <text v-else class="empty-tip">鏆傛棤鏁版嵁</text>
          </view>

          <!-- 瀛ｈ妭鍒嗗竷 -->
          <view class="block" v-if="seasonChart.length">
            <text class="block-title">瀛ｈ妭鍒嗗竷</text>
            <view class="stack-bar">
              <view v-for="s in seasonChart" :key="s.name" class="stack-seg" :style="{ width: s.pct + '%', background: s.color }"></view>
            </view>
            <view class="stack-legend">
              <view v-for="s in seasonChart" :key="s.name" class="stack-leg">
                <view class="legend-dot" :style="{ background: s.color }"></view>
                <text class="stack-leg-t">{{ s.name }} 路 {{ s.value }}</text>
              </view>
            </view>
          </view>

          <!-- 棰滆壊鍒嗗竷 -->
          <view class="block" v-if="colorList.length">
            <text class="block-title">棰滆壊鍒嗗竷</text>
            <view class="color-wrap">
              <view v-for="c in colorList" :key="c.name" class="color-chip">
                <view class="color-dot" :style="{ background: c.hex, borderColor: c.hex === '#f5f5f5' ? '#e4e7ed' : c.hex }"></view>
                <text class="color-name">{{ c.name }}</text>
                <text class="color-cnt">{{ c.value }}</text>
              </view>
            </view>
          </view>

          <!-- 闂茬疆鎻愰啋 -->
          <view class="block">
            <text class="block-title">闂茬疆鎻愰啋</text>
            <view v-if="analysis.unused_items&&analysis.unused_items.length" class="tag-list">
              <text v-for="item in analysis.unused_items" :key="item.id" class="tag warn">{{ item.name }}锛堣秴90澶╋級</text>
            </view>
            <text v-else class="empty-tip">鏆傛棤闂茬疆锛屼繚鎸佸緱寰堝ソ</text>
          </view>

          <!-- 閲嶅璐拱 -->
          <view class="block">
            <text class="block-title">閲嶅璐拱鎻愰啋</text>
            <view v-if="analysis.duplicate_warnings&&analysis.duplicate_warnings.length" class="tag-list">
              <text v-for="d in analysis.duplicate_warnings" :key="d.name" class="tag danger">{{ d.name }} 脳 {{ d.count }}</text>
            </view>
            <text v-else class="empty-tip">鏃犻噸澶嶈喘涔</text>
          </view>

          <!-- 鏅鸿兘寤鸿 -->
          <view class="block" v-if="analysis.suggestions&&analysis.suggestions.length">
            <text class="block-title">鏅鸿兘寤鸿</text>
            <view class="sug-list">
              <view v-for="(s,i) in analysis.suggestions" :key="i" class="sug-item">
                <text class="sug-bullet">鉁</text>
                <text class="sug-text">{{ s }}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 瀵硅瘽鍘嗗彶宸插悎骞惰繘瀵硅瘽鐣岄潰鐨勫乏渚ф娊灞夛紝瑙佸簳閮?history-drawer -->

      <!-- ===== 绌挎惌鏃ュ織锛團R-C7锛夛細閲囩撼璁板綍鍥為【 ===== -->
      <view v-show="currentView==='diary'" class="panel">
        <view class="panel-head between">
          <text class="panel-title">绌挎惌鏃ュ織</text>
          <view class="mini-btn" @click="loadDiary">鍒锋柊</view>
        </view>
        <view v-if="diaryLoading" class="card-box"><text class="loading-text">鍔犺浇涓€</text></view>
        <view v-else-if="diaryStats" class="diary-stats">
          <view class="diary-stat"><text class="ds-n">{{ diaryStats.total_adoptions }}</text><text class="ds-l">閲囩撼鎼厤</text></view>
          <view class="diary-stat"><text class="ds-n">{{ diaryStats.days_active }}</text><text class="ds-l">璁板綍澶╂暟</text></view>
        </view>
        <view v-for="d in diaryDays" :key="d.date" class="diary-day">
          <view class="diary-day-head">
            <text class="diary-day-date">{{ d.date }}</text>
            <text class="diary-day-count">{{ d.items.length }} 浠</text>
          </view>
          <scroll-view scroll-x class="diary-day-items">
            <view v-for="it in d.items" :key="it.id" class="diary-chip" @click="openDetail(it)">
              <image v-if="it.image_url" :src="it.image_url" mode="aspectFill" class="diary-chip-img" />
              <view v-else class="diary-chip-ph" :style="{ background: getItemColorHex(it) }">
                <text>{{ (it.name || '?')[0] }}</text>
              </view>
              <text class="diary-chip-name">{{ it.name }}</text>
            </view>
          </scroll-view>
          <view v-if="d.adoptions && d.adoptions.length" class="diary-adoptions">
            <text v-for="ad in d.adoptions" :key="ad.id" class="diary-ad-tag">
              {{ ad.scene || ad.source }}<text v-if="ad.reason">锛歿{ ad.reason }}</text>
            </text>
          </view>
        </view>
        <view v-if="!diaryLoading && diaryDays.length === 0" class="empty"><text>杩樻病鏈夌┛鎼褰曪紝鍘婚噰绾充竴濂楀惂锝</text></view>
      </view>

      <!-- ===== 鏃ョ▼锛團R-C6 鏃ョ▼鑱斿姩锛夛細搴旂敤鍐呮棩绋嬭〃 ===== -->
      <view v-show="currentView==='calendar'" class="panel">
        <view class="panel-head between">
          <text class="panel-title">鎴戠殑鏃ョ▼</text>
          <view class="mini-btn primary" @click="showCalForm = !showCalForm">{{ showCalForm ? '鏀惰捣' : '锛?娣诲姞' }}</view>
        </view>

        <view v-if="showCalForm" class="cal-form">
          <view class="cal-form-row">
            <input class="cal-input" v-model="calForm.title" placeholder="鏃ョ▼鏍囬锛屽锛氫复鏃朵細璁? />
            <picker class="cal-picker" mode="date" :value="calForm.event_date" @change="e => calForm.event_date = e.detail.value">
              <text class="cal-pick-val">{{ calForm.event_date || '閫夋嫨鏃ユ湡' }}</text>
            </picker>
          </view>
          <view class="cal-form-row">
            <input class="cal-input" v-model="calForm.start_time" placeholder="寮€濮嬫椂闂?濡?09:00" />
            <input class="cal-input" v-model="calForm.occasion" placeholder="鍦哄悎锛氭寮?浼戦棽/杩愬姩" />
          </view>
          <view class="cal-form-row">
            <input class="cal-input" v-model="calForm.location" placeholder="鍦扮偣锛堝彲閫夛級" />
            <view class="cal-btn save" @click="addCalendarEvent">淇濆瓨</view>
          </view>
        </view>

        <view v-if="calLoading" class="card-box"><text class="loading-text">鍔犺浇涓€</text></view>
        <view v-for="ev in calendarEvents" :key="ev.id" class="cal-card">
          <view class="cal-card-left">
            <text class="cal-card-date">{{ ev.event_date }}</text>
            <text class="cal-card-time">{{ ev.start_time || '鍏ㄥぉ' }}</text>
          </view>
          <view class="cal-card-mid">
            <text class="cal-card-title">{{ ev.title }}</text>
            <text class="cal-card-sub">{{ ev.occasion || '鏈寚瀹氬満鍚? }}{{ ev.location ? ' @ ' + ev.location : '' }}</text>
          </view>
          <view class="cal-card-del" @click="deleteCalendarEvent(ev.id)">馃棏</view>
        </view>
        <view v-if="!calLoading && calendarEvents.length === 0" class="empty"><text>鏆傛棤鏃ョ▼锛屾坊鍔犱竴涓瘯璇曪紙褰撳ぉ鏃╂櫒浼氭敹鍒扮┛鎼彁閱掞級</text></view>
      </view>

      <!-- ===== 涓汉涓績 ===== -->
      <view v-show="currentView==='profile'" class="panel">
        <view class="panel-head"><text class="panel-title">涓汉涓績</text></view>
        <view class="me-card">
          <view class="me-avatar">{{ profile.nickname ? profile.nickname[0] : '馃懁' }}</view>
          <view class="me-info">
            <text class="me-name">{{ profile.nickname || '绌挎惌鐢ㄦ埛' }}</text>
            <text class="me-sub">{{ profile.username ? '璐﹀彿锛? + profile.username : 'AI 绌挎惌鍔╂墜鐢ㄦ埛' }}</text>
          </view>
        </view>
        <view class="me-list">
          <view class="me-row" @click="goWardrobe">
            <text class="me-row-l">鎴戠殑琛ｆ┍</text>
            <text class="me-arrow">鈥</text>
          </view>
          <view class="me-row" @click="switchView('notify')">
            <text class="me-row-l">閫氱煡涓績</text>
            <text class="me-badge" v-if="unreadCount>0">{{ unreadCount>99?'99+':unreadCount }}</text>
            <text class="me-arrow">鈥</text>
          </view>
        </view>
        <view class="me-logout" @click="logout">閫€鍑虹櫥褰</view>
      </view>

      <!-- ===== 10. 閫氱煡涓績 ===== -->
      <view v-show="currentView==='notify'" class="panel">
        <view class="panel-head between">
          <text class="panel-title">閫氱煡涓績</text>
          <view class="mini-btn" @click="markAllRead">鍏ㄩ儴宸茶</view>
        </view>
        <view v-if="notifyLoading" class="card-box"><text class="loading-text">鍔犺浇涓€</text></view>
        <view v-for="n in notifications" :key="n.id" :class="['noti', {unread: !n.is_read}]" @click="onNotiClick(n)">
          <view class="noti-top">
            <text :class="['noti-tag', 't-' + n.type]">{{ notiTypeLabel(n.type) }}</text>
            <text class="noti-time">{{ n.created_at }}</text>
          </view>
          <text class="noti-title">{{ n.title }}</text>
          <text class="noti-content">{{ n.content }}</text>
          <image v-if="n.image_url" :src="n.image_url" mode="widthFix" class="noti-img" />
        </view>
        <view v-if="!notifyLoading && notifications.length===0" class="empty"><text>鏆傛棤閫氱煡</text></view>
      </view>
    </scroll-view>

    <!-- 鍘嗗彶渚ц竟鎶藉眽锛堜笌瀵硅瘽鍚堝苟锛氱偣 鈽?鎵撳紑锛岀偣閬僵/鎶藉眽澶栨敹璧凤級 -->
    <view v-show="showHistoryDrawer" class="drawer-wrap">
      <view class="drawer-mask" @click="closeHistoryDrawer"></view>
      <view :class="['history-drawer', { open: drawerOpened }]">
        <view class="drawer-head">
          <text class="drawer-title">瀵硅瘽鍘嗗彶</text>
          <view class="drawer-new" @click="newChat">锛?鏂板缓</view>
        </view>
        <scroll-view class="drawer-list" scroll-y>
          <view v-for="conv in conversations" :key="conv.id" class="drawer-item">
            <view class="di-main" @click="openHistoryChatById(conv.id)">
              <text class="di-q">{{ conv.user_input }}<text v-if="conv.turn_count > 1" class="di-turn">{{ conv.turn_count }}杞璇</text></text>
              <text v-if="conv.agent_response" class="di-a">{{ conv.agent_response }}</text>
              <text v-if="conv._time" class="di-time">{{ conv._time }}</text>
            </view>
            <view class="di-del" @click.stop="deleteConversation(conv.id)">馃棏</view>
          </view>
          <view v-if="conversations.length === 0" class="drawer-empty"><text>鏆傛棤瀵硅瘽璁板綍</text></view>
        </scroll-view>
      </view>
    </view>

    <!-- 搴曢儴瀵艰埅锛堟í鍚戞粴鍔級 -->
    <scroll-view class="bottom-nav" scroll-x>
      <view v-for="item in navItems" :key="item.key"
            :class="['nav-item',{active: currentView===item.key}]" @click="switchView(item.key)">
        <view class="nav-ico-wrap">
          <text class="nav-icon">{{ item.icon }}</text>
          <text v-if="item.key==='notify' && unreadCount>0" class="badge">{{ unreadCount>99?'99+':unreadCount }}</text>
        </view>
        <text class="nav-label">{{ item.label }}</text>
      </view>
    </scroll-view>

    <!-- 涓婁紶寮圭獥锛圖PSTAR 椋庢牸锛?-->
    <view v-if="showUpload" class="mask" @click="closeUpload">
      <view class="wh-upload-dialog" @click.stop>
        <!-- 澶撮儴 -->
        <view class="wh-dlg-head">
          <text class="wh-dlg-back" @click="closeUpload">杩斿洖</text>
          <text class="wh-dlg-title">璁板綍鏂扮殑琛ｆ湇</text>
          <text></text>
        </view>

        <!-- 涓婁紶鍖?-->
        <view class="wh-dlg-up-area" @click="chooseWardrobeImage">
          <text class="wh-dlg-up-ico">馃摲</text>
          <text class="wh-dlg-up-txt">涓婁紶 / 鏇挎崲鐓х墖</text>
        </view>

        <!-- 鎵归噺涓婁紶鍏ュ彛 -->
        <view class="wh-dlg-batch" @click="chooseBatchImages">
          <text class="wh-dlg-batch-ico">馃柤锔</text>
          <text class="wh-dlg-batch-txt">鎵归噺涓婁紶鐓х墖锛堜笂闄?0寮狅級</text>
        </view>

        <!-- 棰勮 + 琛ㄥ崟 -->
        <view v-if="uploadPreview" class="wh-dlg-body">
          <!-- 褰撳墠鍗曞搧鍥?-->
          <view class="wh-dlg-preview">
            <image :src="uploadPreview" mode="aspectFit" class="wh-dlg-preview-img" />
            <view v-if="uploadDetecting" class="wh-dlg-detect"><text>AI 鑷姩璇嗗埆涓?..</text></view>
          </view>
          <text class="wh-dlg-preview-tip">淇敼鏃朵細淇濈暀鍘熷浘鐗囷紝閲嶆柊涓婁紶鍙浛鎹€</text>

          <!-- 鍙屽垪琛ㄥ崟 -->
          <view v-if="uploadPreview && !uploadDetecting" class="wh-dlg-form">
            <view class="wh-dlg-row">
              <view class="wh-dlg-field">
                <text class="wh-dlg-label">鍗曞搧鍚嶇О</text>
                <input class="wh-dlg-input" :value="uploadForm.name" placeholder="渚嬶細鐧借壊瀹芥澗鍗拌姳T鎭?
                       @input="e => onFormInput(e, 'name')" />
              </view>
              <view class="wh-dlg-field">
                <text class="wh-dlg-label">鍝佺被</text>
                <picker class="wh-dlg-picker" :range="catLabels" @change="onCatChange">
                  <text :class="['wh-dlg-pick-val', { placeholder: !uploadForm.category }]">{{ catMap[uploadForm.category] || '璇烽€夋嫨' }}</text>
                </picker>
              </view>
            </view>
